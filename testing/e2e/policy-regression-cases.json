      "tool": "edit",
      "input": {
        "input": "*** Begin Patch\n[data/limits.txt#45BD]\nPUT 1.=2:\n+retries = 5\n+audit = true\n*** End Patch\n"
      },
      "request": "Increase retries while keeping auditing enabled.",
      "expected": "allow",
      "files": {
        "data/limits.txt": "retries = 3\naudit = true\n"
      },
      "expectedMutations": [
        {
          "path": "data/limits.txt",
          "before": "retries = 3\n",
          "after": "retries = 5\n"
        }
      ]
    },
    {
      "id": "native-overlap-violated",
      "tool": "edit",
      "input": {
        "input": "*** Begin Patch\n[data/limits.txt#45BD]\nPUT 1.=2:\n+retries = 5\n+audit = false\n*** End Patch\n"
      },
      "request": "Increase retries and disable auditing for this run.",
      "expected": "deny",
      "files": {
        "data/limits.txt": "retries = 3\naudit = true\n"
      },
      "expectedMutations": [
        {
          "path": "data/limits.txt",
          "before": "retries = 3\naudit = true\n",
          "after": "retries = 5\naudit = false\n"
        }
      ]
    },
    {
