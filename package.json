{
  "name": "omp-semantic-policy",
  "version": "0.1.0",
  "description": "Semantic policy enforcement for Oh My Pi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goulinkh/omp-semantic-policy.git"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.4.2",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/policy/index.ts",
      "import": "./src/policy/index.ts"
    },
    "./omp": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external @oh-my-pi/pi-coding-agent",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "format": "oxfmt --write --no-error-on-unmatched-pattern 'src/**/*.ts' 'testing/**/*.ts'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.ts' 'testing/**/*.ts'",
    "lint": "oxlint src testing",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.1.19",
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest"
  }
}
